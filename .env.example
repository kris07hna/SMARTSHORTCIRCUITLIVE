# Firebase Configuration (for connecting to your RTDB)
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://smart-circuit-monitor-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_DEVICE_PATH=devices/esp32-s3-devkitm-1/ina219

# Polling Configuration (in milliseconds)
NEXT_PUBLIC_POLL_MS=2000
NEXT_PUBLIC_HISTORY_LIMIT=180

# Short Circuit Detection Threshold (in mA)
NEXT_PUBLIC_SHORT_THRESHOLD_MA=10
